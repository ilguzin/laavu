# Caddy for Laavu. Generated by laavu install; manual edits will be overwritten.
{
	# The Caddy admin API would listen on localhost:2019, and the agent could reconfigure the proxy.
	admin off
{{- if .Email}}
	email {{.Email}}
{{- end}}
}

{{.AppSite}} {
{{- if .Internal}}
	# on_demand: for *.ts.net names Caddy fetches the certificate from tailscaled itself,
	# and without it the internal CA does not issue a certificate in advance.
	tls internal {
		on_demand
	}
{{- end}}
	reverse_proxy unix//run/laavu/http/app.sock
}

{{.AuxSites}} {
{{- if .Internal}}
	# on_demand: for *.ts.net names Caddy fetches the certificate from tailscaled itself,
	# and without it the internal CA does not issue a certificate in advance.
	tls internal {
		on_demand
	}
{{- end}}
	reverse_proxy unix//run/laavu/http/aux.sock
}
