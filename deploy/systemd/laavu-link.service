[Unit]
Description=Laavu: link to the management console
After=network-online.target
Wants=network-online.target

[Service]
# Holds the connection to the console without any privileges. Jobs go to the
# root helper (laavu-link-helper.socket), which checks the console signature itself.
User={{.User}}
Group={{.User}}
ExecStart={{.Laavu}} link run
Restart=on-failure
RestartSec=5
RuntimeDirectory=laavu-link
RuntimeDirectoryMode=0755
# laavu unlink reads status.json after the process has exited.
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/srv/laavu/agents
ReadOnlyPaths=/var/lib/laavu-link
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
